<?php

/**
 * @file
 * Install, update and uninstall functions for the civicrm_entity module.
 */

use Drupal\Core\Extension\ModuleWeight;

/**
 * Implements hook_install().
 */
function civicrm_entity_install() {
  _civicrm_entity_set_module_weight(1);
}

/**
 * Set the module weight.
 */
function civicrm_entity_update_8001() {
  _civicrm_entity_set_module_weight(1);
}

/**
 * Sets the module weight across supported Drupal versions.
 *
 * Drupal 11.5 introduced the ModuleWeight service. The dynamic legacy call is
 * retained only for Drupal 11.3 and 11.4, where the function is not deprecated.
 */
function _civicrm_entity_set_module_weight(int $weight): void {
  if (class_exists(ModuleWeight::class)) {
    \Drupal::service(ModuleWeight::class)
      ->set('civicrm_entity', $weight);
    return;
  }

  $legacy_set_weight = 'module_set_weight';
  $legacy_set_weight('civicrm_entity', $weight);
}

/**
 * Enable Drupal pages for enabled entity types.
 */
function civicrm_entity_update_8002() {
  $config = \Drupal::service('config.factory')->getEditable('civicrm_entity.settings');
  $enable_links_per_type = [];

  foreach ($config->get('enabled_entity_types') as $entity_type) {
    $enable_links_per_type[$entity_type]['values'] = [
      'view' => 'view',
      'add' => 'add',
      'edit' => 'edit',
      'delete' => 'delete',
    ];
  }

  $config
    ->set('enable_links_per_type', $enable_links_per_type)
    ->save();
}
