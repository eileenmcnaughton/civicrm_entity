<?php

/**
 * @file
 * Module file for CiviCRM Entity Bundles.
 */

use Drupal\civicrm_entity_bundles\Hook\BundleHooks;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function civicrm_entity_bundles_entity_type_alter(array &$entity_types) {
  \Drupal::service(BundleHooks::class)->entityTypeAlter($entity_types);
}

/**
 * Implements hook_entity_base_field_info().
 */
#[LegacyHook]
function civicrm_entity_bundles_entity_base_field_info(EntityTypeInterface $entity_type) {
  return \Drupal::service(BundleHooks::class)->entityBaseFieldInfo($entity_type);
}

/**
 * Implements hook_entity_bundle_info().
 */
#[LegacyHook]
function civicrm_entity_bundles_entity_bundle_info() {
  return \Drupal::service(BundleHooks::class)->entityBundleInfo();
}

/**
 * Implements hook_entity_bundle_field_info().
 */
#[LegacyHook]
function civicrm_entity_bundles_entity_bundle_field_info(EntityTypeInterface $entity_type, $bundle, array $base_field_definitions) {
  return \Drupal::service(BundleHooks::class)->entityBundleFieldInfo($entity_type, $bundle, $base_field_definitions);
}

/**
 * Implements hook_entity_view_display_alter().
 */
#[LegacyHook]
function civicrm_entity_bundles_entity_view_display_alter(EntityViewDisplayInterface $display, array $context) {
  \Drupal::service(BundleHooks::class)->entityViewDisplayAlter($display, $context);
}
